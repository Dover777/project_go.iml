@startuml
skinparam state {
  BackgroundColor White
  BorderColor Black
}

[*] --> OczekiwanieNaGraczy

state OczekiwanieNaGraczy {
  [*] --> BrakGraczy : Serwer uruchomiony
  BrakGraczy --> JedenGracz : Gracz 1 (Black) łączy się
  JedenGracz --> GraWToku : Gracz 2 (White) łączy się
}

state GraWToku {
  [*] --> TuraCzarnego

  state TuraCzarnego {
    TuraCzarnego : Czeka na ruch lub komendę
  }

  state TuraBialego {
    TuraBialego : Czeka na ruch lub komendę
  }

  ' Przejścia tury
  TuraCzarnego --> TuraBialego : placementResult.success() / pass()
  TuraBialego --> TuraCzarnego : placementResult.success() / pass()

  ' Obsługa błędów (pętla)
  TuraCzarnego --> TuraCzarnego : Błąd (zajęte, KO, samobójstwo)
  TuraBialego --> TuraBialego : Błąd (zajęte, KO, samobójstwo)

  ' Warunki zakończenia wewnątrz gry
  TuraCzarnego --> PodliczanieWynikow : pass() gdy passCount == 1
  TuraBialego --> PodliczanieWynikow : pass() gdy passCount == 1
  TuraCzarnego --> KoniecPrzezPoddanie : ff()
  TuraBialego --> KoniecPrzezPoddanie : ff()
}

state PodliczanieWynikow {
  PodliczanieWynikow : GAME_LOGIC.setTerritory()
  PodliczanieWynikow : Wysłanie punktów do obu graczy
}

state KoniecPrzezPoddanie {
  KoniecPrzezPoddanie : Ogłoszenie zwycięzcy przez walkower
}

PodliczanieWynikow --> WylaczanieSerwera
KoniecPrzezPoddanie --> WylaczanieSerwera

state WylaczanieSerwera {
  WylaczanieSerwera : Thread.sleep(2000)
  WylaczanieSerwera : System.exit(0)
}

WylaczanieSerwera --> [*]

@enduml